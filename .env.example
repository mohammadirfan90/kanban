# Local development environment template (without Docker).
# Copy this file to `.env` if you're running the services directly with
# `npm run dev` / `npm run start:dev` instead of via docker compose.
#
# For Docker setup, see .env.docker.example instead.

# ── Backend (matches backend/.env.example) ──────────────────────────
DATABASE_URL=postgresql://kanban:kanban@localhost:5432/kanban
JWT_SECRET=replace-with-32-bytes-of-random-data
JWT_EXPIRES_IN=24h
CORS_ORIGIN=http://localhost:3000
PORT=3001
NODE_ENV=development

# ── Frontend (matches frontend/.env.example) ───────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api
