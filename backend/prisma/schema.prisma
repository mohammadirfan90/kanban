// Prisma schema for the Mini Kanban Board
// See specs/01-database-schema.md for the full contract
// Connection URL is configured in prisma.config.ts (Prisma 7 requirement)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Role hierarchy: OWNER > EDITOR > VIEWER
enum BoardRole {
  OWNER
  EDITOR
  VIEWER
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedBoards   Board[]       @relation("BoardOwner")
  memberships   BoardMember[]
  assignedTasks Task[]        @relation("TaskAssignee")

  @@map("users")
}

model Board {
  id          String   @id @default(uuid())
  title       String
  description String?
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // owner is Restrict (not Cascade) per spec: deleting a user must NOT cascade-delete their boards
  owner   User          @relation("BoardOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members BoardMember[]
  columns Column[]

  @@index([ownerId])
  @@map("boards")
}

model BoardMember {
  id        String    @id @default(uuid())
  boardId   String
  userId    String
  role      BoardRole
  createdAt DateTime  @default(now())

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  // User deletion cascades to BoardMember rows (per spec)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
  @@index([userId])
  @@map("board_members")
}

model Column {
  id        String   @id @default(uuid())
  boardId   String
  title     String
  // Fractional position for stable ordering (Spec 08 uses this for task movement)
  position  Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([boardId, position])
  @@map("columns")
}

model Task {
  id          String   @id @default(uuid())
  columnId    String
  title       String
  description String?
  // Fractional position for drag-and-drop reordering without renumbering
  position    Float
  assigneeId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  column   Column @relation(fields: [columnId], references: [id], onDelete: Cascade)
  // If assignee is deleted, task remains but assignee becomes null
  assignee User?  @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([columnId, position])
  @@index([assigneeId])
  @@map("tasks")
}
