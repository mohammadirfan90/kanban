// Prisma schema for the Mini Kanban Board
// See specs/01-database-schema.md for the full contract
// Connection URL is configured in prisma.config.ts (Prisma 7 requirement)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Role hierarchy: OWNER > EDITOR > VIEWER
enum BoardRole {
  OWNER
  EDITOR
  VIEWER
}

// Ordered low -> urgent. Nullable on Task: "no priority set" is a real state
// and is not the same as LOW.
enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedBoards   Board[]       @relation("BoardOwner")
  memberships   BoardMember[]
  assignedTasks Task[]        @relation("TaskAssignee")

  @@map("users")
}

model Board {
  id          String   @id @default(uuid())
  title       String
  description String?
  ownerId     String
  // Short prefix for human-readable task keys, e.g. "PR" -> PR-14.
  key         String
  // Monotonic per-board task counter. Incremented atomically so two concurrent
  // creates cannot claim the same number; never decremented, so deleting a task
  // does not recycle its key.
  taskCounter Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // owner is Restrict (not Cascade) per spec: deleting a user must NOT cascade-delete their boards
  owner   User          @relation("BoardOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members BoardMember[]
  columns Column[]
  labels  Label[]
  tasks   Task[]

  @@index([ownerId])
  @@map("boards")
}

model BoardMember {
  id        String    @id @default(uuid())
  boardId   String
  userId    String
  role      BoardRole
  createdAt DateTime  @default(now())

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  // User deletion cascades to BoardMember rows (per spec)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
  @@index([userId])
  @@map("board_members")
}

model Column {
  id        String   @id @default(uuid())
  boardId   String
  title     String
  // Fractional-index key (base62, ordered lexicographically). See
  // src/common/ordering/fractional-index.ts for why this is a String and not
  // a Float. The unique constraint is the backstop that makes concurrent
  // reorders conflict-free: two racing writers cannot both land on one key.
  position  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@unique([boardId, position])
  @@map("columns")
}

// Labels are per-board, not global: two boards may both want a "bug" label
// without sharing one row, and deleting a board should take its labels with it.
model Label {
  id        String   @id @default(uuid())
  boardId   String
  name      String
  // A palette token ("rose", "amber", ...), not a hex value — DESIGN.md forbids
  // hardcoded colors, and storing a token lets both themes resolve it.
  color     String
  createdAt DateTime @default(now())

  board Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks TaskLabel[]

  @@unique([boardId, name])
  @@map("labels")
}

model TaskLabel {
  taskId  String
  labelId String

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([labelId])
  @@map("task_labels")
}

model Task {
  id          String        @id @default(uuid())
  columnId    String
  // Denormalised from column.boardId. Safe because cross-board moves are
  // rejected, so a task's board never changes. Carries the per-board unique
  // constraint on `number`, which cannot span a relation.
  boardId     String
  // Per-board sequence behind the display key (BOARD.key + "-" + number).
  number      Int
  title       String
  description String?
  priority    TaskPriority?
  dueDate     DateTime?
  // Fractional-index key (base62, ordered lexicographically) — never
  // renumbered, unlike the Float midpoints this replaced.
  position    String
  assigneeId  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  column   Column      @relation(fields: [columnId], references: [id], onDelete: Cascade)
  board    Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  // If assignee is deleted, task remains but assignee becomes null
  assignee User?       @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  labels   TaskLabel[]

  @@unique([columnId, position])
  @@unique([boardId, number])
  @@index([dueDate])
  @@index([assigneeId])
  @@map("tasks")
}
