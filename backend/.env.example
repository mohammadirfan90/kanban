# Backend environment template — copy to .env and fill in real values.
# DO NOT commit .env (it's gitignored).

# Database — Postgres connection string (standard/Docker port is 5432;
# change to 5433 if 5432 is occupied by an existing host Postgres service)
DATABASE_URL=postgresql://kanban:kanban@localhost:5432/kanban?schema=public

# Auth — JWT settings (required for Spec 04)
# Generate a real secret with: openssl rand -base64 32
JWT_SECRET=replace-with-32-bytes-of-random-data
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30

# CORS — origin allowed to call the API (frontend URL)
CORS_ORIGIN=http://localhost:3000

# Server
PORT=3001
NODE_ENV=development
# ── Google sign-in (optional) ─────────────────────────────────────────────
# Leave blank to disable: GET /api/auth/providers then reports google=false and
# the login page hides the button entirely.
# Create credentials at https://console.cloud.google.com/apis/credentials
#   Authorised redirect URI must match GOOGLE_CALLBACK_URL exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
# Where the callback sends the browser once cookies are set. Never taken from a
# query parameter — that is how OAuth callbacks become open redirects.
PUBLIC_APP_URL=http://localhost:3000
