# Backend environment template — copy to .env and fill in real values.
# DO NOT commit .env (it's gitignored).

# Database — Postgres connection string
DATABASE_URL=postgresql://kanban:kanban@localhost:5432/kanban?schema=public

# Auth — JWT settings (required for Spec 04)
# Generate a real secret with: openssl rand -base64 32
JWT_SECRET=replace-with-32-bytes-of-random-data
JWT_EXPIRES_IN=24h

# CORS — origin allowed to call the API (frontend URL)
CORS_ORIGIN=http://localhost:3000

# Server
PORT=3001
NODE_ENV=development