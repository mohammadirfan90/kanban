{
  "name": "webbriks-kanban",
  "version": "0.1.0",
  "private": true,
  "description": "Mini Kanban Board - NestJS API + Next.js UI",
  "scripts": {
    "dev": "npm-run-all --parallel dev:backend dev:frontend",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "lint": "npm --prefix backend run lint && npm --prefix frontend run lint",
    "typecheck": "npm --prefix frontend run typecheck",
    "test": "npm --prefix backend run test",
    "test:e2e": "npm --prefix backend run test:e2e",
    "up": "node scripts/up.mjs",
    "down": "docker compose down",
    "logs": "docker compose logs -f"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
