# Docker compose environment template.
# Copy this file to `.env` and edit before running `docker compose up`:
#   cp .env.docker.example .env

# ── Backend ──────────────────────────────────────────────────────────
# Generate a real secret with: openssl rand -base64 32
JWT_SECRET=change-me-in-production-use-32-bytes-of-random
JWT_EXPIRES_IN=24h

# Comma-separated list of allowed CORS origins.
CORS_ORIGIN=http://localhost:3000

# ── Frontend ─────────────────────────────────────────────────────────
# Inlined at Next.js build time, so changing it requires a rebuild.
# For Docker: same host/port the user accesses the frontend from, with /api.
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ── Host ports ───────────────────────────────────────────────────────
# Only the *host* side of each mapping. Services always reach each other
# over the compose network on their standard ports, so changing these
# affects your browser and host tools (psql, Prisma CLI) — nothing else.
#
# Leave them commented out and use `npm run up`, which probes each port
# and picks the next free one automatically, then derives CORS_ORIGIN and
# NEXT_PUBLIC_API_URL to match. Set them here only to pin a port.
#
# FRONTEND_PORT=3000
# BACKEND_PORT=3001
# POSTGRES_PORT=5432
