# Docker compose environment template.
# Copy this file to `.env` and edit before running `docker compose up`:
#   cp .env.docker.example .env

# ── Backend ──────────────────────────────────────────────────────────
# Generate a real secret with: openssl rand -base64 32
JWT_SECRET=change-me-in-production-use-32-bytes-of-random
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated list of allowed CORS origins.
CORS_ORIGIN=http://localhost:3000

# ── Frontend ─────────────────────────────────────────────────────────
# Inlined at Next.js build time, so changing it requires a rebuild.
# For Docker: same host/port the user accesses the frontend from, with /api.
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ── Host ports ───────────────────────────────────────────────────────
# Only the *host* side of each mapping. Services always reach each other
# over the compose network on their standard ports, so changing these
# affects your browser and host tools (psql, Prisma CLI) — nothing else.
#
# Leave them commented out and use `npm run up`, which probes each port
# and picks the next free one automatically, then derives CORS_ORIGIN and
# NEXT_PUBLIC_API_URL to match. Set them here only to pin a port.
#
# FRONTEND_PORT=3000
# BACKEND_PORT=3001
# POSTGRES_PORT=5432

# ── Google sign-in (optional) ─────────────────────────────────────────────
# Leave blank to disable: GET /api/auth/providers then reports google=false and
# the login page hides the button entirely.
# Create credentials at https://console.cloud.google.com/apis/credentials
#   Authorised redirect URI must match GOOGLE_CALLBACK_URL exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
# Where the callback sends the browser once cookies are set. Never taken from a
# query parameter — that is how OAuth callbacks become open redirects.
PUBLIC_APP_URL=http://localhost:3000
